// The former flat `alloc_core.rs` / `alloc_core_core_diag.rs` /
// `bootstrap.rs` face files, mechanically split into this group module (the
// 1000-line cap). Every child is re-exported by the `alloc_core` root at its
// original visibility so each stays reachable at its existing
// `alloc_core::<name>` module path.
/// Group module: the 15 bench/diagnostic counter statics
/// (`DECOMMIT_CALLS`..`PROMOTION_BYTES_HIST`), the `promotion_byte_bucket`
/// bucketing fn, the `FOREIGN_OR_UNROUTABLE_FREES` stat static, and the
/// `LargeCacheHitCounter` alias — with the `#[cfg]` feature gates each
/// definition already carried.
pub(super) mod counters;
/// Group module: the constructor cluster (`new`, `new_with_config`,
/// `live_config_matches`, `new_inner`) plus the `bench-internals`-gated
/// `DBG_RESERVATION_OWNER_ID_COUNTER`.
pub(super) mod ctor;
/// Group module: the alloc/dealloc/realloc entry points and their in-place
/// fast paths (`alloc`, `alloc_zeroed`, `dealloc`, `realloc`,
/// `safe_payload_read_span`, `realloc_inplace_fast_path_known_base`,
/// `try_grow_large_reserved_capacity`, `try_realloc_inplace_known_base`).
pub(super) mod mem;
/// Group module: the NUMA-cluster state accessors
/// (`NUMA_NODE_REFRESH_PERIOD`, `current_node_cached`,
/// `invalidate_numa_node_cache`, `dbg_*_numa_node`) and the table-query fns
/// (`segment_bases`, `contains_base`, `small_cur`, `classify`).
pub(super) mod state;
/// Group module: the `dbg_*` diagnostic/test-only `impl AllocCore` hooks
/// (the former flat `alloc_core_core_diag.rs`, mechanically split into
/// `mod.rs` + `header_diag.rs` + `perf_diag.rs` + `directory_diag.rs`).
pub(super) mod alloc_core_core_diag;
/// The primordial bootstrap (`primordial()`), moved unchanged from
/// `src/alloc_core/bootstrap.rs` (import paths rewritten only).
pub(super) mod bootstrap;

// The statics/types that moved into the `counters` sibling are re-exported
// here (at their original visibility/cfg parity) so every pre-reorg
// `alloc_core::alloc_core::<name>` module path stays valid — the consumers
// are the root's own `pub(crate) use alloc_core::{LARGE_ZERO_PASS_CALLS,
// ..}` forwarders (read by the registry), `segment_table`'s Tier-1
// `contains_base` counters, the `alloc_core_large*` cache machinery, and the
// small-path decommit hooks. Like every `pub use` re-export, these are
// exempt from the unused-imports lint.
#[cfg(feature = "alloc-decommit")]
pub(super) use counters::{DECOMMIT_CALLS, LargeCacheHitCounter};
#[cfg(all(feature = "alloc-decommit", feature = "bench-internals"))]
pub(super) use counters::{FORCE_DECAY_CLOCK_READ, MAYBE_DECAY_GUARD_PASSED};
#[cfg(feature = "bench-internals")]
pub(super) use counters::{CONTAINS_BASE_TIER1_HITS, CONTAINS_BASE_TIER1_MISSES};
#[cfg(feature = "alloc-core")]
pub(crate) use counters::FOREIGN_OR_UNROUTABLE_FREES;
pub(crate) use counters::{
    LARGE_ZERO_PASS_CALLS, OPT_H_ATTEMPTS, OPT_H_HITS, PROMOTION_BYTES_HIST,
    PROMOTION_BYTES_MAX, PROMOTION_BYTES_MIN, PROMOTION_BYTES_SUM, PROMOTION_COUNT,
    RELOC_FASTPATH_DECLINE_CALLS, RELOC_INPLACE_LARGE_CALLS, RELOC_INPLACE_SMALL_CALLS,
    SMALL_ZERO_PASS_CALLS,
};
#[cfg(all(
    feature = "bench-internals",
    feature = "medium-classes",
    any(
        not(feature = "exact-span-large"),
        all(feature = "large-reserved-capacity", not(feature = "numa-aware"))
    )
))]
pub(crate) use counters::promotion_byte_bucket;

