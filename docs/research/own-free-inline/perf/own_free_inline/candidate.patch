--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1190,6 +1190,14 @@ required-features = ["alloc-global", "alloc-xthread"]
 # exhibits the ~16 MiB first-touch) only reaches ~7.5 KiB/slot under
 # `alloc-decommit` + `fastbin`; with just alloc-global+alloc-xthread each slot is
