	.section	.rodata..Lanon.fa7aa94085c500bee56846251e396804.11,"a",@progbits
.Lanon.fa7aa94085c500bee56846251e396804.11:
	.asciz	"\nload_next(\300\013) returned \301 \000\200`$, neither TAIL nor a valid index (< \301 \000\200`=): pop_index's truncating pack would silently truncate it to \300"
	.size	.Lanon.fa7aa94085c500bee56846251e396804.11, 135

	.type	.Lanon.fa7aa94085c500bee56846251e396804.12,@object
