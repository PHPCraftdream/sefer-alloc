     #[cold]
     #[inline(never)]
     fn refill_magazine_slow(&mut self, c: usize) -> *mut u8 {
+        // MEASUREMENT-ONLY depot: reload a parked full magazine (blocks are MAG).
+        {
+            use crate::registry::heap_core::state::tcache::{DEPOT_CLASSES, TCACHE_CAP};
+            if c < DEPOT_CLASSES && self.tcache.depot_n[c] > 0 {
+                let d = self.tcache.depot_n[c] as usize - 1;
+                self.tcache.depot_n[c] = d as u8;
+                self.tcache.classes[c].slots = self.tcache.depot[c][d];
+                return self.finish_magazine_refill(c, TCACHE_CAP);
+            }
+        }
         // Bounded Large-only probe; Small discovery occurs in the refill.
         self.drain_large_sidecar_ingress_hot_bounded();
 
