+            self.index,
+            SegmentHeader::segment_id_at(self.base) as usize,
+            "batch commit: run index must still be its segment's stamped id",
+        );
+        #[cfg(feature = "alloc-global")]
+        if let Some(inner) = &mut self.routed {
+            inner.commit_range(start, stride, n);
