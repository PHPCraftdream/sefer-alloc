--- a/src/registry/heap_core/state/depot_paths.rs
+++ b/src/registry/heap_core/state/depot_paths.rs
@@ -1,11 +1,129 @@
-//! Cold owner-side parking and reload for full magazines.
+//! Cold owner-side parking and reload for full magazines: the depot floor
+//! (K5's path, unchanged) and, under `alloc-decommit`, the G1-K7 overflow
