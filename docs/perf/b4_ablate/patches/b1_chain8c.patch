+    /// MEASUREMENT-ONLY: park the full magazine of class `c` (cold).
+    #[cold]
+    #[inline(never)]
+    pub(crate) fn depot_park(&mut self, c: usize) -> bool {
+        use crate::registry::heap_core::state::tcache::{DEPOT_K, TCACHE_CAP};
+        let _ = TCACHE_CAP;
+        let d = self.tcache.depot_n[c] as usize;
+        if d >= DEPOT_K {
+            return false;
+        }
+        let slots = self.tcache.classes[c].slots;
+        let mut next = self.tcache.chain_head[c];
+        let mut i = TCACHE_CAP;
+        while i > 0 {
+            i -= 1;
+            let b = core::ptr::NonNull::new(slots[i]).expect("magazine slot");
+            crate::alloc_core::node::Node::write_next(b, next);
+            next = slots[i];
+        }
+        self.tcache.chain_head[c] = next;
+        self.tcache.depot_n[c] = (d + 1) as u8;
+        true
+    }
+
+    /// MEASUREMENT-ONLY: reload a parked magazine of class `c` (cold).
+    #[cold]
+    #[inline(never)]
+    pub(crate) fn depot_reload(&mut self, c: usize) -> bool {
+        let d = self.tcache.depot_n[c] as usize;
+        if d == 0 {
+            return false;
+        }
+        let mut p = self.tcache.chain_head[c];
+        for i in 0..TCACHE_CAP {
+            let b = core::ptr::NonNull::new(p).expect("chain node");
+            self.tcache.classes[c].slots[i] = p;
+            p = crate::alloc_core::node::Node::read_next(b);
+        }
+        self.tcache.chain_head[c] = p;
+        self.tcache.depot_n[c] = (d - 1) as u8;
+        true
+    }
+
