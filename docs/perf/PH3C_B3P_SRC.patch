new file mode 100644
index 00000000..c5577748
--- /dev/null
+++ b/tests/b3p_interleave_footprint.rs
@@ -0,0 +1,43 @@
+//! Ph3c step 1′ (B3 per-class carve cursors) — interleaved footprint.
+//!
+//! Counterfactual footprint guard: interleaving the six smallest classes
+//! (16/32/48/64/80/112 B round-robin) through `AllocCore` with NO frees must
+//! consume at most ONE small segment. Counterfactually red on spike 093c9d23
+//! (W1 C/B=4.013): the pre-fix carve cursor let runs be taken misaligned/
+//! overlapping, forcing repeated small-segment reserves at the same volume.
+//!
+//! Segment count via `AllocCore::dbg_table_count` (the segment table's
+//! high-water registered slot count): the delta from a fresh core must be 0.
+#![cfg(all(feature = "production", feature = "internals", feature = "bench-internals"))]
+
+use sefer_alloc::{AllocCore, SegmentLayout};
+
+#[test]
+fn interleave_40k_small_allocs_single_segment() {
+    let sizes: [usize; 6] = [16, 32, 48, 64, 80, 112];
+    // ~58.7 B avg * 40 000 ≈ 2.3 MiB of issued bytes: fits one 4 MiB segment.
+    const N: usize = 40_000;
+
+    let mut core = AllocCore::new().expect("AllocCore::new");
+    let base_count = core.dbg_table_count();
+
+    let mut ptrs: Vec<*mut u8> = Vec::with_capacity(N);
+    for i in 0..N {
+        let size = sizes[i % sizes.len()];
+        let layout = core::alloc::Layout::from_size_align(size, 8).unwrap();
+        // SAFETY: non-zero size, valid alignment; freed when `core` drops.
+        let ptr = core.alloc(layout);
+        assert!(!ptr.is_null(), "alloc null at i={i} (size {size})");
+        ptrs.push(ptr);
+    }
+    drop(ptrs);
+
+    let after = core.dbg_table_count();
+    assert_eq!(
+        after, base_count,
+        "interleaved small carve footprint reserved extra segments: {} -> {}",
+        base_count, after
+    );
+    // Sanity: the segment actually served the full volume (payload capacity).
+    assert!(N * sizes.iter().sum::<usize>() / sizes.len() <= SegmentLayout::SEGMENT);
+}
diff --git a/tests/b3p_leaf_boundary_no_overlap.rs b/tests/b3p_leaf_boundary_no_overlap.rs
new file mode 100644
index 00000000..88d0edef
--- /dev/null
+++ b/tests/b3p_leaf_boundary_no_overlap.rs
@@ -0,0 +1,96 @@
+//! Ph3c step 1′ (B3 per-class carve cursors) — leaf-boundary classes.
+//!
+//! Classes whose block size does NOT divide 4096 (48, 80, 112, 144, 1536,
+//! 1888, 2368, 2560, 3072) allocate enough blocks to exhaust several carve
+//! runs and cross run boundaries mid-batch. Every issued block is checked
+//! by ADDRESS against the segment substrate:
+//!   (a) blocks of a class are pairwise disjoint `[ptr, ptr+bs)` intervals;
+//!   (b) each block's segment offset is a multiple of its block size;
+//!   (c) EVERY 4 KiB sub-leaf the block touches is bound to its own class
+//!       (`leaf_class == class_idx + 1`, 0 = unbound must never appear).
+//! Note a block MAY straddle a sub-leaf boundary inside its run (runs are
+//! contiguous k leaves); it must never leave the leaves of its own run,
+//! which (c) proves.
+#![cfg(all(feature = "production", feature = "internals", feature = "bench-internals"))]
+
+use sefer_alloc::{AllocCore, SegmentLayout};
+
+const LEAF: usize = 4096;
+
+/// Desired boundary sizes; each rounds UP to its actual size class.
+const LEAF_BOUNDARY_SIZES: [usize; 9] = [48, 80, 112, 144, 1536, 1888, 2368, 2560, 3072];
+
+/// Enough blocks to take several runs per class (max k = 4 leaves/run).
+fn count_for(bs: usize) -> usize {
+    (4 * LEAF * 4 / bs).max(64) + 16
+}
+
+#[test]
+fn leaf_boundary_blocks_are_aligned_bound_and_disjoint() {
+    let table = SegmentLayout::SIZE_CLASS_TABLE;
+    let segment_mask = !(SegmentLayout::SEGMENT - 1);
+
+    // Desired sizes round UP to their actual size class (some, e.g. 1536,
+    // are not exact table entries); duplicate classes are dropped.
+    let mut class_list: Vec<usize> = Vec::new();
+    for &bs in &LEAF_BOUNDARY_SIZES {
+        let class = SegmentLayout::try_class_for(bs, 8)
+            .ok()
+            .flatten()
+            .expect("class");
+        if !class_list.contains(&class) {
+            class_list.push(class);
+        }
+    }
+
+    let mut core = AllocCore::new().expect("AllocCore::new");
+    let mut by_class: Vec<Vec<usize>> = vec![Vec::new(); class_list.len()];
+
+    for (ci, &class) in class_list.iter().enumerate() {
+        let bs = table[class];
+        let layout = core::alloc::Layout::from_size_align(bs, 8).unwrap();
+        for _ in 0..count_for(bs) {
+            // SAFETY: non-zero size, valid alignment; core outlives checks.
+            let ptr = core.alloc(layout);
+            assert!(!ptr.is_null(), "alloc null (bs {bs})");
+            let addr = ptr as usize;
+            let base = addr & segment_mask;
+            let off = addr - base;
+
+            // (b) block offset is block-size aligned within the segment.
+            assert_eq!(off % bs, 0, "bs {bs}: offset {off} misaligned");
+
+            // (c) every sub-leaf touched by the block is bound to this class.
+            let first_leaf = off / LEAF;
+            let last_leaf = (off + bs - 1) / LEAF;
+            for leaf in first_leaf..=last_leaf {
+                let lc = sefer_alloc::b3p_leaf_class_of((base + leaf * LEAF) as *mut u8);
+                assert_eq!(
+                    lc,
+                    (class + 1) as u8,
+                    "bs {bs}: leaf {leaf} bound to {lc}, expected {}",
+                    class + 1
+                );
+            }
+            by_class[ci].push(addr);
+        }
+    }
+
+    // (a) pairwise disjoint intervals per class.
+    for (ci, &class) in class_list.iter().enumerate() {
+        let bs = table[class];
+        let mut addrs = by_class[ci].clone();
+        addrs.sort_unstable();
+        addrs.dedup();
+        assert_eq!(addrs.len(), by_class[ci].len(), "bs {bs}: duplicate block address");
+        for w in addrs.windows(2) {
+            assert!(
+                w[0] + bs <= w[1],
+                "bs {bs}: blocks [0x{:x}, 0x{:x}) and 0x{:x} overlap",
+                w[0],
+                w[0] + bs,
+                w[1]
+            );
+        }
+    }
+}
diff --git a/tests/b3s_oracle.rs b/tests/b3s_oracle.rs
new file mode 100644
index 00000000..04f15f2c
--- /dev/null
+++ b/tests/b3s_oracle.rs
@@ -0,0 +1,39 @@
+//! B3 spike oracle (temporary): ≥95% of refill blocks must come from the
+//! sub-leaf free structure on the recycle pattern (escalation §4.2).
+#![cfg(all(feature = "production", feature = "bench-internals", feature = "internals"))]
+use sefer_alloc::SeferAlloc;
+use std::alloc::GlobalAlloc;
+
+#[test]
+fn b3s_recycle_refill_from_free_structure() {
+    let sefer = SeferAlloc::new();
+    let layout = core::alloc::Layout::from_size_align(16, 8).unwrap();
+    let mut ptrs: [*mut u8; 256] = [core::ptr::null_mut(); 256];
+    for round in 0..2 {
+        let before = sefer_alloc::b3s_drain_from_free();
+        for slot in ptrs.iter_mut() {
+            // SAFETY: non-zero size, valid alignment; freed below same layout.
+            *slot = unsafe { sefer.alloc(layout) };
+        }
+        for &p in &ptrs {
+            assert!(!p.is_null(), "alloc failed in round {round}");
+        }
+        let after = sefer_alloc::b3s_drain_from_free();
+        let from_free = after - before;
+        println!("[b3s-oracle] round {round}: served=256 from_free={from_free} ({:.1}%)",
+            from_free as f64 * 100.0 / 256.0);
+        if round == 1 {
+            // tcache (16 slots) still holds 16 blocks after round-1 free; those
+            // are magazine HITS, not refill. Refill = served − tcache hits.
+            const TCACHE_CAP: u64 = 16;
+            let refill = 256 - TCACHE_CAP;
+            assert!(from_free * 100 >= 95 * refill, "refill-from-free {from_free}/{refill} < 95%");
+            println!("[b3s-oracle] round 1: refill={refill} from_free={from_free} ({:.1}%)",
+                from_free as f64 * 100.0 / refill as f64);
+        }
+        // SAFETY: same layout as allocated above; freed exactly once.
+        for &p in &ptrs {
+            unsafe { sefer.dealloc(p, layout) };
+        }
+    }
+}
