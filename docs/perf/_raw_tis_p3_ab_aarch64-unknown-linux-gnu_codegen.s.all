	.asciz	"Aindex must be < INDEX_MASK (the empty sentinel is reserved), got \300\017 (INDEX_MASK = \301 \000\200`\001)"
	.size	.Lanon.a8bfb3e8b9fd6e33beee9d2edb5f05da.13, 91

	.type	.Lanon.a8bfb3e8b9fd6e33beee9d2edb5f05da.14,@object
