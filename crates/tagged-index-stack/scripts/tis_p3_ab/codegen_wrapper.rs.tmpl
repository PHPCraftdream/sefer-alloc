// Codegen probes for the production-shaped registry storage.

#![deny(unsafe_code)]

#[allow(unused_attributes)]
#[path = "lib.rs"]
pub mod tis;

use core::hint::black_box;
use core::sync::atomic::{AtomicU32, Ordering};
use tis::{StackHead, StackOps, StackStorage};

const LINKS: usize = 256;
const MATERIALIZED_VARIANT: &str = "{{VARIANT_NAME}}";

#[repr(align(64))]
struct RegistrySlot {
    next_free: AtomicU32,
}

impl RegistrySlot {
    const fn new() -> Self {
        Self { next_free: AtomicU32::new(0) }
    }
}

struct RegistryShapedStorage {
    head: StackHead<16>,
    slots: [RegistrySlot; LINKS],
}

// This models Registry's ownership shape, not HeapSlot's byte layout.

impl RegistryShapedStorage {
    fn new() -> Self {
        Self {
            head: StackHead::new(),
            slots: [const { RegistrySlot::new() }; LINKS],
        }
    }

    fn slot(&self, index: u32) -> &RegistrySlot {
        &self.slots[index as usize]
    }
}

// SAFETY:
// 1. `self.head` has one binding for this storage value's lifetime.
// 2. `slots[index]` is a stable mapping used by both link hooks.
// 3. Distinct values share neither heads, cells, nor populations.
// 4. Every valid index has one dedicated cell holding TAIL or a domain index.
// 5. `head()` always returns this value's same head.
// 6. The domain is exactly 0..256, within the 16-bit index domain.
// 7. AtomicU32 makes races atomic; placeholders select Acquire/Release for
//    base and the intentional Relaxed candidate.
// 8. The private hook bodies below are reached only through this binding's
//    stack algorithm: `store_next` is called by push before its publishing
//    CAS, and `load_next` is called by pop only after a push through this
//    exact binding has published the observed index.
// 9. A push consumes its unique publish/recycle authority at its successful
//    head CAS, not at physical return; a successful pop may transfer that
//    authority to another thread, which may legally repush before the earlier
//    push call returns.
#[allow(unsafe_code)]
unsafe impl StackStorage<16> for RegistryShapedStorage {
    /// # Safety
    ///
    /// The caller uses this head only with this storage's own link binding.
    #[inline(always)]
    unsafe fn head(&self) -> &StackHead<16> {
        &self.head
    }

    /// # Safety
    ///
    /// `index` is in 0..256 and was initialized through this same binding.
    #[inline(always)]
    unsafe fn load_next(&self, index: u32) -> u32 {
        self.slot(index).next_free.load({{LINK_LOAD_ORDERING}})
    }

    /// # Safety
    ///
    /// `index` is in-domain, non-live, and uniquely owned; `next` is TAIL or
    /// the observed in-domain head, and this store precedes publication.
    #[inline(always)]
    unsafe fn store_next(&self, index: u32, next: u32) {
        self.slot(index).next_free.store(next, {{LINK_STORE_ORDERING}});
    }
}

// These private, non-inlined bodies are named codegen probes. `instantiate`
// preserves their function pointers for assembly extraction but never invokes
// them; the hook bodies above perform the algorithm's actual link accesses.
#[inline(never)]
fn tis_probe_load_next(stack: &RegistryShapedStorage, index: u32) -> u32 {
    stack.slot(index).next_free.load({{LINK_LOAD_ORDERING}})
}

#[inline(never)]
fn tis_probe_store_next(stack: &RegistryShapedStorage, index: u32, next: u32) {
    stack.slot(index).next_free.store(next, {{LINK_STORE_ORDERING}});
}

#[inline(never)]
#[allow(unsafe_code)]
/// Forces the crate-owned push monomorphization.
///
/// # Safety
///
/// `index` is in this binding's 0..256 domain, is not live in any binding
/// sharing its cells, and the caller owns one unique fresh or recycled publish
/// authority that this call consumes.
unsafe fn tis_probe_push_index_impl(stack: &RegistryShapedStorage, index: u32) {
    // SAFETY: the caller guarantees domain membership, non-liveness, and one
    // unique publish authority, forwarded unchanged to StackOps.
    unsafe { StackOps::push_index(stack, index) }
        .expect("codegen probe push must not seal");
}

#[inline(never)]
fn tis_probe_pop_index_impl(stack: &RegistryShapedStorage) {
    let _ = StackOps::pop_index(stack);
}

#[allow(unsafe_code)]
pub fn instantiate() {
    let _ = MATERIALIZED_VARIANT;
    black_box((
        tis_probe_load_next as fn(&RegistryShapedStorage, u32) -> u32,
        tis_probe_store_next as fn(&RegistryShapedStorage, u32, u32),
    ));
    let stack = RegistryShapedStorage::new();
    // SAFETY: index 1 is in this binding's domain, is initially non-live, and
    // its unique fresh publish authority is consumed by this stack-algorithm
    // push. That push performs the hook store before its publishing CAS; the
    // following pop performs the hook load only after that legitimate push
    // through this exact head-to-links binding.
    unsafe {
        black_box(tis_probe_push_index_impl)(black_box(&stack), black_box(1u32));
    }
    black_box(tis_probe_pop_index_impl)(black_box(&stack));
}
