// Codegen-forcing wrapper for the link-ordering/CAS A/B mode.
//
// Why this file exists: `rustc --emit=asm --crate-type=lib` on the bare
// `lib.rs` monomorphizes NOTHING — every interesting function in the crate
// (`push_index`/`pop_index`/`ArrayLinks::load_next`/`store_next` and the
// stack's push/pop entry points) is generic (over the storage type or const
// parameters), so without a concrete use LLVM emits only the panic-path
// helpers and the extraction finds no function blocks. This wrapper forces
// exactly one monomorphization of each function we study through explicit
// `#[inline(never)]` probe symbols with extractable labels.
//
// The lib.rs/imp.rs pair next to this file is a VERBATIM copy of the crate
// sources (or the variant substitution applied to imp.rs); this wrapper is
// only the instantiation vehicle and contributes no logic of its own.
//
// `push` is `pub unsafe fn` (see `crates/tagged-index-stack/src/imp.rs`'s
// `StackOps::push_index` doc for the three-clause caller contract: link domain
// + liveness + exclusive ownership). Same statement-scoped `#[allow(unsafe_code)]` + `// SAFETY:`
// convention as the sibling `scripts/tis_p3_ab/harness_bin.rs`;
// `#![deny(unsafe_code)]` below still covers every other line in this file.

#![deny(unsafe_code)]

// `lib.rs` is a verbatim crate-root copy, so its own `#![no_std]` is an inner
// attribute meant for that position; included here as a submodule, rustc
// warns `unused_attributes` (attribute only valid at crate root). Allow it on
// this one declaration rather than editing the copied source.
#[allow(unused_attributes)]
#[path = "lib.rs"]
pub mod tis;

use core::hint::black_box;

#[inline(never)]
#[allow(unsafe_code)]
/// Calls the production push path for codegen extraction.
///
/// # Safety
///
/// `index` is in this stack's link domain, is not currently reachable from
/// the stack, and this call owns its exclusive publish/recycle epoch.
pub unsafe fn tis_probe_push_index_impl(
    stack: &tis::ArrayIndexStack<16, 256>,
    index: u32,
) {
    // SAFETY: the caller upholds the stack push contract.
    #[allow(unsafe_code)]
    unsafe { tis::ArrayIndexStack::push(stack, index) }
    .expect("codegen probe push must not hit tag seal");
}

#[inline(never)]
pub fn tis_probe_pop_index_impl(stack: &tis::ArrayIndexStack<16, 256>) {
    let _ = tis::ArrayIndexStack::pop(stack);
}

#[inline(never)]
pub fn tis_probe_load_next(links: &tis::ArrayLinks<256>, index: u32) -> u32 {
    tis::ArrayLinks::load_next(links, index)
}

#[inline(never)]
pub fn tis_probe_store_next(links: &tis::ArrayLinks<256>, index: u32, next: u32) {
    tis::ArrayLinks::store_next(links, index, next);
}

pub fn instantiate() {
    let stack: tis::ArrayIndexStack<16, 256> = tis::ArrayIndexStack::new();
    // SAFETY: `stack` is fresh and index 1 is in-domain and exclusively owned.
    #[allow(unsafe_code)]
    unsafe { black_box(tis_probe_push_index_impl)(black_box(&stack), black_box(1u32)); }
    black_box(tis_probe_pop_index_impl)(black_box(&stack));
    let links = tis::ArrayLinks::<256>::new();
    black_box(tis_probe_load_next)(black_box(&links), black_box(0u32));
    black_box(tis_probe_store_next)(black_box(&links), black_box(0u32), black_box(1u32));
}
